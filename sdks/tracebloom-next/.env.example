# =============================================================================
# Tracebloom SDK consumer | copy values into your application's server environment
# =============================================================================
# The SDK does not load this file automatically. Your framework/runtime must load it.
# Keep these credentials on the server; never prefix an API key with NEXT_PUBLIC_.
# Create a real API key in the Tracebloom dashboard. It is shown only once.
TRACEBLOOM_API_KEY=

# Full NestJS API base URL, including /api/v1.
# Used automatically by the transport; createLogger({ baseUrl }) overrides it.
TRACEBLOOM_SERVER_URI=http://localhost:8080/api/v1

# TRACEBLOOM_API_KEY is read by your integration code and passed to createLogger.
# Example:
# createLogger({ apiKey: process.env.TRACEBLOOM_API_KEY, appName: "my-app" })
# The environment defaults to NODE_ENV; appName defaults to "default".
