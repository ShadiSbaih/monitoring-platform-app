# =============================================================================
# Tracebloom dashboard | copy to apps/main-dashboard/.env.local
# =============================================================================
# Server-only NestJS API URL. Include /api/v1; omit a trailing slash.
# Local app processes use cloud Neon/Upstash through this API.
# Production example: https://YOUR-API.onrender.com/api/v1
SERVER_URI=http://localhost:8080/api/v1

# Authentication cookies are created by dashboard route handlers.
# No JWT signing secret, database password, Redis token or email key belongs here.
# Next.js sets NODE_ENV from the command; production cookies are Secure + HttpOnly.
