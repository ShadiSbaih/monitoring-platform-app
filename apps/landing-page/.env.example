# =============================================================================
# Tracebloom marketing | copy to apps/landing-page/.env.local
# =============================================================================
# Public dashboard origin used by account and onboarding links.
# Production example: https://YOUR-DASHBOARD.vercel.app
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001

# Optional canonical marketing origin. Leave unset on Vercel to detect its hostname.
# Set this if hosting elsewhere or using a custom domain later.
# NEXT_PUBLIC_SITE_URL=https://YOUR-MARKETING.vercel.app

# NEXT_PUBLIC_* values are public and embedded at build time.
# This app requires no provider credentials or authentication secrets.
