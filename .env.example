# =============================================================================
# Tracebloom workspace environment reference
# =============================================================================
# This root template is a catalog, not an automatically loaded shared environment.
# Copy each component's own template to its documented destination:
#   services/.env.example                 -> services/.env
#   apps/main-dashboard/.env.example      -> apps/main-dashboard/.env.local
#   apps/landing-page/.env.example        -> apps/landing-page/.env.local
#   sdks/tracebloom-next/.env.example      -> your SDK consumer's server environment
# Use the same variables in the corresponding provider's deployment settings.
# Read README.md before supplying credentials. Never commit populated env files.

# --- API only: Render / services/.env -----------------------------------------
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.neon.tech/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/DATABASE?sslmode=require
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=
# Optional alternative, takes precedence over Upstash REST:
# REDIS_URL=rediss://default:PASSWORD@YOUR-DATABASE.upstash.io:6379

# Generate each independently (JWT_SECRET must contain at least 32 characters).
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
REDIS_KEY_SECRET=
WEBHOOK_SIGNING_SECRET=
APP_URL=http://localhost:3001
FRONTEND_ORIGINS=http://localhost:3001
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Positive integer limits. Shared caps apply across all accounts.
OML_EVENTS_PER_USER_DAY=1000
OML_PLATFORM_EVENTS_DAY=5000
OML_PLATFORM_BATCHES_DAY=750
OML_PLATFORM_BYTES_DAY=33554432
OML_QUEUE_MAX_BYTES=67108864

# --- Dashboard only: Vercel / dashboard .env.local -----------------------------
# Server-only URL, including the API version prefix.
SERVER_URI=http://localhost:8080/api/v1

# --- Marketing only: Vercel / marketing .env.local -----------------------------
# Public values; rebuild after changing them.
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
# Optional; otherwise Vercel hostname is detected:
# NEXT_PUBLIC_SITE_URL=https://YOUR-MARKETING.vercel.app

# --- SDK consumer only: server-side application environment --------------------
TRACEBLOOM_API_KEY=
TRACEBLOOM_SERVER_URI=http://localhost:8080/api/v1

# --- Optional verification runner --------------------------------------------
# API and frontend processes must already be running at these URLs.
# OML_SMOKE_API_URL=http://localhost:8080/api/v1
# OML_SMOKE_DASHBOARD_URL=http://localhost:3001
# OML_SMOKE_LANDING_URL=http://localhost:3000

# NODE_ENV and VERCEL_* deployment metadata are provided by the runtime/host.
# Never copy API-only secrets into either frontend or a browser SDK integration.
