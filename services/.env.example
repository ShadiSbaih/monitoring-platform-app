# =============================================================================
# Tracebloom API and consumers | copy to services/.env
# =============================================================================
# Required: Neon, Upstash, three independent secrets, and Brevo for account email.
# Frontends must never receive these provider credentials or signing secrets.
# Hosting sets NODE_ENV=production; Render supplies PORT in its environment.
PORT=8080

# --- Neon Postgres ------------------------------------------------------------
# Pooled connection for application traffic. Replace every URL placeholder.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.neon.tech/DATABASE?sslmode=require
# Direct connection for schema changes. Falls back to DATABASE_URL when omitted.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/DATABASE?sslmode=require

# --- Upstash Redis ------------------------------------------------------------
# Recommended REST connection. Leave eviction disabled in the provider console.
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=
# Optional TLS TCP alternative. When set, REDIS_URL takes precedence over REST.
# REDIS_URL=rediss://default:PASSWORD@YOUR-DATABASE.upstash.io:6379

# --- Application secrets ------------------------------------------------------
# Generate each value separately; never reuse one secret for another purpose.
# Run three times: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
REDIS_KEY_SECRET=
WEBHOOK_SIGNING_SECRET=

# --- Dashboard URLs -----------------------------------------------------------
# Dashboard origin used for verification/reset links, without a trailing slash.
# Production example: https://YOUR-DASHBOARD.vercel.app
APP_URL=http://localhost:3001
# Comma-separated allowed dashboard origins; use exact scheme, host and port.
FRONTEND_ORIGINS=http://localhost:3001

# --- Brevo account email ------------------------------------------------------
# Required to deliver verification and password recovery links.
# BREVO_SENDER_EMAIL must already be verified in the Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- Admission limits ---------------------------------------------------------
# Positive integers. Days reset at 00:00 UTC; byte values are accounting bytes.
# Shared caps bound the entire service, including all users and smoke tests.
OML_EVENTS_PER_USER_DAY=1000
OML_PLATFORM_EVENTS_DAY=5000
OML_PLATFORM_BATCHES_DAY=750
OML_PLATFORM_BYTES_DAY=33554432
# Outstanding ingestion + alert work; 64 MiB accounting ceiling.
OML_QUEUE_MAX_BYTES=67108864

# --- Optional cloud verification ---------------------------------------------
# Disposable fixtures are generated and removed by the test suite.
# OML_SMOKE_API_URL=http://localhost:8080/api/v1
# Enable browser checks against an already running dashboard:
# OML_SMOKE_DASHBOARD_URL=http://localhost:3001
# Also verify the running marketing app:
# OML_SMOKE_LANDING_URL=http://localhost:3000
